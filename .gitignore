# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# UniFFI bindings in platforms/macos/Generated are committed on purpose, not ignored
# All build outputs (xcframework, GitVersion.swift, dmg staging and installers) live under build/
/build

# Xcode
platforms/*/DerivedData/
*.xcuserstate
**/xcuserdata/
DerivedData/

# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/

# SDD scratch (subagent-driven-development ledger and briefs)
.superpowers/

# Defensive: secrets and signing material must never be committed
syno_session*
*.pem
*.p12
.env
.env.*
*.mobileprovision
