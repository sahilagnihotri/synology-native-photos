# Generated at build time (short git SHA for the About window)
app/Generated/

# Xcode
app/DerivedData/
app/**/xcuserdata/
app/**/*.xcuserstate
*.xcuserstate
**/xcuserdata/
DerivedData/

# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/

# SDD scratch (subagent-driven-development ledger and briefs)
.superpowers/

# Defensive: secrets and signing material must never be committed
syno_session*
*.pem
*.p12
.env
.env.*
*.mobileprovision
